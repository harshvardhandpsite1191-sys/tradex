# AI-QROS — Environment Variables Template
# Phase 0: Project Foundation
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
APP_NAME=AI-QROS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────
# DATABASE — Neon PostgreSQL (Free Tier)
# Get from: https://neon.tech → New Project → Connection String
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/aiqros?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@host.neon.tech/aiqros?sslmode=require

# ─────────────────────────────────────────────
# REDIS — Upstash (Free Tier)
# Get from: https://upstash.com → New Database → Redis URL
# ─────────────────────────────────────────────
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# ─────────────────────────────────────────────
# CELERY
# ─────────────────────────────────────────────
CELERY_BROKER_URL=rediss://default:password@your-endpoint.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://default:password@your-endpoint.upstash.io:6379/1

# ─────────────────────────────────────────────
# UPSTOX API — Indian Market Data (Free)
# Get from: https://upstox.com/developer/api-documentation
# Register app → Get API Key & Secret
# ─────────────────────────────────────────────
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=your-upstox-access-token

# ─────────────────────────────────────────────
# OPENROUTER API — News/LLM Processing (Free Tier)
# Get from: https://openrouter.ai → Sign Up → API Keys
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─────────────────────────────────────────────
# MLFLOW — Experiment Tracking
# Deployed on Render free tier
# ─────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aiqros-research

# ─────────────────────────────────────────────
# CORS — Frontend URL
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# MARKET HOURS (IST)
# ─────────────────────────────────────────────
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────
# HISTORICAL DATA
# ─────────────────────────────────────────────
HISTORICAL_YEARS=5

# ─────────────────────────────────────────────
# ANGEL ONE SMARTAPI — Historical F&O Data (FREE)
# Replaces need for paid Upstox historical expired contract data.
# Get from: https://smartapi.angelone.in → Register → Get API Key
# Requires a free Angel One trading account.
# ─────────────────────────────────────────────
ANGEL_ONE_API_KEY=your-angel-one-api-key
ANGEL_ONE_CLIENT_ID=your-angel-one-client-id
ANGEL_ONE_PASSWORD=your-angel-one-password
ANGEL_ONE_TOTP_SECRET=your-totp-secret-from-google-authenticator

# ─────────────────────────────────────────────
# UPTIMEROBOT — Keep Render Free Tier Alive (FREE)
# Register: https://uptimerobot.com → Add Monitor → HTTP(s)
# URL: https://your-app.onrender.com/ping
# Interval: Every 5 minutes
# ─────────────────────────────────────────────
# Configure on UptimeRobot dashboard — no env var needed
